meta {
  name: Tra cứu số nước
  type: http
  seq: 1
}

post {
  url: {{domainUrl}}/customer/water/meter-check
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenNhanVien}}
}

body:multipart-form {
  ~ma_dong_ho: DH1-KH1-PDP-KP1-T01 @contentType(Khi tìm kiếm: nếu có mã đồng hồ thì hiển thị lịch sử số nước của đồng hồ, không có thì hiển thị tất cả lịch sử số nước)
}

settings {
  encodeUrl: true
  timeout: 0
}
