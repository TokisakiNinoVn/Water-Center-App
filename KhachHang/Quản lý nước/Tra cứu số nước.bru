meta {
  name: Tra cứu số nước
  type: http
  seq: 1
}

get {
  url: {{domainUrl}}/customer/water/meter-check/DH002NNN
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenKhachHang}}
}

body:multipart-form {
  ~ma_dong_ho:  @contentType(Khi tìm kiếm: nếu có mã đồng hồ thì hiển thị lịch sử số nước của đồng hồ, không có thì hiển thị tất cả lịch sử số nước)
}

settings {
  encodeUrl: true
  timeout: 0
}
