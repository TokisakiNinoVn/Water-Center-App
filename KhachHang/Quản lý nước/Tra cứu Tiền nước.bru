meta {
  name: Tra cứu Tiền nước
  type: http
  seq: 2
}

get {
  url: {{domainUrl}}/customer/water/bill-check/HD202650001
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenKhachHang}}
}

body:multipart-form {
  ~ma_hoa_don: HD202650001 @contentType(Khi tìm kiếm: nếu có mã đồng hồ thì hiển thị lịch sử số nước của đồng hồ, không có thì hiển thị tất cả lịch sử số nước)
}

settings {
  encodeUrl: true
  timeout: 0
}
