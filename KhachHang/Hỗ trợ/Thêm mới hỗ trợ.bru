meta {
  name: Thêm mới hỗ trợ
  type: http
  seq: 1
}

post {
  url: {{domainUrl}}/customer/support/store-new-support
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenNhanVien}}
}

body:multipart-form {
  tieu_de: Đồng hồ nước lỗi
  noi_dung: đồng hồ nước của tôi đang lỗi không chạy
}

settings {
  encodeUrl: true
  timeout: 0
}
