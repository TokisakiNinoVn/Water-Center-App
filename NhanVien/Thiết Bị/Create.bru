meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{domainUrl}}/water-meter/store
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenNhanVien}}
}

body:multipart-form {
  khach_hang_id: 6
  ma_tuyen_doc: 3
  ma_tuyen_thu: 3
  ma_dong_ho: DH3-KH1-PDP-KP1-T02 @contentType(số đồng hồ + mã KH +Mã Hợp đồng)
  ma_hop_dong: 6
  vung_id: 1
  khu_vuc_id: 1
  seri: 321465654
  seri_chi: 45631123
  ngay_lap_dat: 2026-04-24
  hang_sx: Việt Nam
  ma_doi_tuong_gia: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
